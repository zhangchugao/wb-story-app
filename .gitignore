# WorkBuddy 会话元数据（非项目文件）
.workbuddy/
*.genie

# 依赖与构建产物
**/node_modules/
**/dist/
**/.vite/
**/*.tsbuildinfo

# 环境变量与本地数据
**/.env
**/data/
**/storage/audio/*
!**/storage/audio/.gitkeep

# 日志与系统文件
**/*.log
.DS_Store
Thumbs.db

# SQLite 版归档（git 历史中已有完整版本，无需重复入库）
story-backend/_legacy/

# 后端生成的静态文件（封面可由 tools 脚本重新生成）
**/storage/static/*
!**/storage/static/.gitkeep

# 设计工具临时产物
story-redesign/.temp/
