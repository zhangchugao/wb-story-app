/* 我的页 · 陪听的晚上 */
.page { padding: 30rpx 40rpx 80rpx; }

.profile {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
}
.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--night3), var(--night2));
  border: 2rpx solid rgba(245, 201, 123, 0.4);
  color: var(--lamp);
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.profile-info { margin-left: 28rpx; }
.nickname { font-size: 36rpx; font-weight: 700; color: var(--fg); }
.profile-sub { font-size: 26rpx; margin-top: 10rpx; }

.stats { display: flex; gap: 20rpx; margin-top: 24rpx; }
.stat { flex: 1; padding: 30rpx; }
.stat-num { font-size: 44rpx; font-weight: 700; color: var(--fg); }
.stat-label { font-size: 24rpx; margin-top: 8rpx; }

/* 哄睡提醒卡：暖色渐变（全站第二处暖色） */
.remind-card {
  display: flex;
  align-items: flex-start;
  margin-top: 24rpx;
  padding: 30rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, rgba(245, 201, 123, 0.16), rgba(232, 169, 79, 0.08));
  border: 1rpx solid rgba(245, 201, 123, 0.25);
}
.remind-moon { font-size: 40rpx; color: var(--lamp); flex-shrink: 0; }
.remind-body { margin-left: 22rpx; }
.remind-title { font-size: 30rpx; font-weight: 600; color: var(--moon); }
.remind-sub { font-size: 24rpx; color: var(--muted); line-height: 1.6; margin-top: 10rpx; }

/* 入口 */
.menu { margin-top: 32rpx; overflow: hidden; }
.menu-row {
  display: flex;
  align-items: center;
  padding: 30rpx 32rpx;
  border-bottom: 1rpx solid rgba(233, 237, 247, 0.08);
}
.menu-row:last-child { border-bottom: none; }
.menu-row-hover { background: rgba(255, 255, 255, 0.04); }
.menu-icon { font-size: 30rpx; width: 56rpx; }
.menu-text { flex: 1; font-size: 30rpx; color: var(--fg); }
.menu-arrow { font-size: 34rpx; }

.footer { text-align: center; font-size: 24rpx; margin-top: 50rpx; }
