<view class="page">
  <!-- 陪听人 -->
  <view class="profile night-card">
    <view class="avatar">{{avatarLetter}}</view>
    <view class="profile-info">
      <view class="nickname">{{userInfo.nickname || '听故事的人'}}</view>
      <view class="profile-sub muted">已经陪听了 {{listenNights}} 个晚上</view>
    </view>
  </view>

  <!-- 陪听小统计 -->
  <view class="stats">
    <view class="stat night-card">
      <view class="stat-num">{{favoritedCount}}</view>
      <view class="stat-label muted">放在晚安盒里的</view>
    </view>
    <view class="stat night-card">
      <view class="stat-num">{{historyCount}}</view>
      <view class="stat-label muted">听过的故事</view>
    </view>
  </view>

  <!-- 哄睡提醒卡：全站第二处暖色 -->
  <view class="remind-card">
    <view class="remind-moon">☾</view>
    <view class="remind-body">
      <view class="remind-title">哄睡提醒开着</view>
      <view class="remind-sub">每晚 20:30 提醒你打开今晚的故事，到点前 10 分钟也可以取消。</view>
    </view>
  </view>

  <!-- 入口 -->
  <view class="menu night-card">
    <view
      class="menu-row"
      wx:for="{{menuItems}}"
      wx:key="key"
      bindtap="handleMenuTap"
      data-path="{{item.path}}"
      hover-class="menu-row-hover"
    >
      <view class="menu-icon muted">{{item.icon}}</view>
      <view class="menu-text">{{item.text}}</view>
      <view class="menu-arrow faint">›</view>
    </view>
  </view>

  <view class="footer muted">听故事 · 内测版</view>
</view>
