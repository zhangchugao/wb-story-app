<view class="page">
  <!-- 页眉：日期 + 晚安时间 -->
  <view class="head-row">
    <text class="date muted">{{dateText}}</text>
    <text class="head-lamp">晚安时间</text>
  </view>
  <view class="page-title">今晚，先把这个故事<text class="lamp">讲完</text>吧</view>

  <!-- 接着讲：继续听大卡（首屏主角） -->
  <view class="hero night-card" wx:if="{{continueStory}}" bindtap="goDetail" data-id="{{continueStory.id}}">
    <view class="hero-media">
      <image class="hero-img" src="{{continueStory.cover}}" mode="aspectFill" />
      <view class="hero-shade"></view>
      <view class="hero-badge">昨晚听到 {{continueStory.positionText}}</view>
      <view class="hero-overlay">
        <view class="hero-title">{{continueStory.title}}</view>
        <view class="hero-meta">{{continueStory.narrator}} · 还剩 {{continueStory.remainText}}</view>
        <view class="hero-progress">
          <view class="hero-bar">
            <view class="hero-fill" style="width:{{continueStory.percent}}%"></view>
          </view>
          <view class="hero-play" catchtap="goPlayer" data-id="{{continueStory.id}}">▶</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 分类胶囊 -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">今晚想听哪一种</text>
      <text class="section-link" bindtap="goCategory">全部分类</text>
    </view>
    <view class="cat-row">
      <view
        class="cat-pill night-card"
        wx:for="{{cats}}"
        wx:key="id"
        hover-class="pill-hover"
        bindtap="goCategory"
        data-id="{{item.id}}"
      >
        <view class="cat-ico">{{item.glyph}}</view>
        <view class="cat-name">{{item.name}}</view>
      </view>
    </view>
  </view>

  <!-- 睡前的孩子都在听：横滑 -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">睡前的孩子都在听</text>
      <text class="section-link">慢慢挑</text>
    </view>
    <scroll-view scroll-x class="rail" enhanced show-scrollbar="{{false}}">
      <view class="rail-list">
        <view
          class="rail-card"
          wx:for="{{hotStories}}"
          wx:key="id"
          hover-class="pill-hover"
          bindtap="goDetail"
          data-id="{{item.id}}"
        >
          <image class="rail-img" src="{{item.cover}}" mode="aspectFill" />
          <view class="rail-title">{{item.title}}</view>
          <view class="rail-meta muted">{{item.narrator}} · {{item.durationText}}</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="foot-tip muted">把手机放到远处，声音刚刚好</view>
  <view class="loading-tip muted" wx:if="{{loading}}">正在准备今晚的故事…</view>
</view>
