/* 首页 · 今夜的灯 */
.page { padding: 30rpx 40rpx 60rpx; }

.head-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10rpx;
}
.date { font-size: 24rpx; }
.head-lamp { font-size: 24rpx; color: var(--lamp); }

.page-title {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--fg);
  line-height: 1.4;
  margin: 16rpx 0 36rpx;
}

/* 接着讲大卡 */
.hero { overflow: hidden; border-radius: 40rpx; }
.hero-media { position: relative; width: 100%; height: 420rpx; }
.hero-img { width: 100%; height: 100%; display: block; }
.hero-shade {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 65%;
  background: linear-gradient(180deg, rgba(10, 16, 32, 0) 0%, rgba(10, 16, 32, 0.78) 78%);
}
.hero-badge {
  position: absolute;
  top: 22rpx; left: 22rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--moon);
  background: rgba(10, 16, 32, 0.55);
  border: 1rpx solid rgba(233, 237, 247, 0.18);
}
.hero-overlay {
  position: absolute;
  left: 30rpx; right: 30rpx; bottom: 26rpx;
}
.hero-title { font-size: 42rpx; font-weight: 700; color: #fff; }
.hero-meta { font-size: 24rpx; color: rgba(233, 237, 247, 0.78); margin-top: 8rpx; }
.hero-progress {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.hero-bar {
  flex: 1;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(233, 237, 247, 0.18);
  overflow: hidden;
}
.hero-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--lamp-deep), var(--lamp));
}
.hero-play {
  width: 84rpx;
  height: 84rpx;
  margin-left: 24rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--lamp), var(--lamp-deep));
  color: #1A2438;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 36rpx rgba(245, 201, 123, 0.35);
  flex-shrink: 0;
}

/* 区块 */
.section { margin-top: 48rpx; }
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 24rpx;
}

/* 分类胶囊 */
.cat-row { display: flex; justify-content: space-between; }
.cat-pill {
  width: 158rpx;
  padding: 26rpx 0 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.cat-ico { font-size: 36rpx; color: var(--moon); opacity: 0.85; }
.cat-name { font-size: 26rpx; color: var(--fg); margin-top: 12rpx; }
.pill-hover { opacity: 0.8; }

/* 横滑推荐 */
.rail { width: 100%; }
.rail-list { display: flex; padding-right: 40rpx; }
.rail-card {
  width: 300rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
}
.rail-img {
  width: 300rpx;
  height: 300rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(233, 237, 247, 0.10);
}
.rail-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--fg);
  margin-top: 14rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.rail-meta { font-size: 24rpx; margin-top: 4rpx; }

.foot-tip { text-align: center; font-size: 24rpx; margin-top: 56rpx; }
.loading-tip { text-align: center; font-size: 24rpx; padding: 40rpx 0; }
