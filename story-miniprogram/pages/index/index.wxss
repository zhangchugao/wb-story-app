.greeting {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 8rpx 36rpx;
}
.greeting-title {
  font-size: 44rpx;
  font-weight: 800;
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}
.greeting-badge {
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #34d399, #10b981);
  color: #fff;
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 30rpx rgba(16, 185, 129, 0.3);
  transform: rotate(-8deg);
}

/* 焦点 Banner */
.featured {
  display: flex;
  padding: 24rpx;
  gap: 24rpx;
  align-items: center;
  transform-style: preserve-3d;
}
.featured-cover {
  width: 220rpx;
  height: 260rpx;
  flex-shrink: 0;
  transform: rotateY(-8deg) rotateX(4deg);
  box-shadow: 0 20rpx 40rpx rgba(31, 42, 55, 0.18);
}
.featured-play {
  position: absolute;
  z-index: 3;
  bottom: 18rpx;
  right: 18rpx;
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  color: var(--mint-deep);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.15);
}
.featured-info { flex: 1; min-width: 0; }
.featured-title {
  font-size: 38rpx;
  font-weight: 800;
  margin: 14rpx 0 8rpx;
}
.featured-desc {
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.featured-meta { font-size: 22rpx; margin-top: 16rpx; }

/* 通用 section */
.section { margin-top: 48rpx; }
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 0 8rpx 24rpx;
}

/* 分类横滑 */
.cat-scroll, .hot-scroll { white-space: nowrap; }
.cat-list, .hot-list { display: inline-flex; gap: 20rpx; padding: 8rpx; }
.cat-item, .hot-item { display: inline-block; }
.cat-card {
  width: 150rpx;
  height: 150rpx;
  border-radius: 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}
.cat-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 20rpx;
  background: var(--mint-soft);
  color: var(--mint-deep);
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cat-name { font-size: 24rpx; font-weight: 600; }

/* 热门卡片 */
.hot-card { width: 200rpx; padding: 16rpx; border-radius: 26rpx; }
.hot-cover { width: 100%; height: 200rpx; }
.hot-label { font-size: 36rpx; }
.hot-title { font-size: 26rpx; font-weight: 700; margin-top: 16rpx; }
.hot-meta { font-size: 20rpx; margin-top: 6rpx; }

/* 双列网格 */
.grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.grid-item { width: calc(50% - 10rpx); }
.grid-card { padding: 16rpx; border-radius: 26rpx; overflow: hidden; }
.grid-cover { width: 100%; height: 220rpx; }
.grid-label { font-size: 40rpx; }
.grid-duration {
  position: absolute;
  z-index: 3;
  right: 14rpx;
  bottom: 14rpx;
  background: rgba(0, 0, 0, 0.35);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}
.grid-body { padding: 16rpx 4rpx 4rpx; }
.grid-title { font-size: 28rpx; font-weight: 700; }
.grid-desc { font-size: 22rpx; margin-top: 8rpx; }

.loading-tip { text-align: center; font-size: 24rpx; padding: 40rpx; }
