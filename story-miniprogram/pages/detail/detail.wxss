/* 详情页 · 翻开今晚的故事 */
.page { padding: 30rpx 40rpx 120rpx; }

.cover-card {
  position: relative;
  overflow: hidden;
  border-radius: 40rpx;
  height: 460rpx;
}
.cover-img { width: 100%; height: 100%; display: block; }
.cover-shade {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 62%;
  background: linear-gradient(180deg, rgba(10, 16, 32, 0) 0%, rgba(10, 16, 32, 0.8) 80%);
}
.fav-btn {
  position: absolute;
  top: 24rpx; right: 24rpx;
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: var(--moon);
  background: rgba(10, 16, 32, 0.5);
  border: 1rpx solid rgba(233, 237, 247, 0.18);
}
.fav-on { color: var(--lamp); border-color: rgba(245, 201, 123, 0.45); }
.cover-overlay { position: absolute; left: 34rpx; bottom: 34rpx; right: 140rpx; }
.cover-title { font-size: 46rpx; font-weight: 700; color: #fff; }
.cover-byline { font-size: 26rpx; color: rgba(233, 237, 247, 0.78); margin-top: 10rpx; }
.cover-play {
  position: absolute;
  right: 30rpx; bottom: 30rpx;
  width: 92rpx; height: 92rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--lamp), var(--lamp-deep));
  color: #1A2438;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 40rpx rgba(245, 201, 123, 0.4);
}

/* 标签 */
.tags { display: flex; align-items: center; gap: 16rpx; margin-top: 30rpx; }
.tag-soft {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--muted);
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(233, 237, 247, 0.10);
}

/* 简介 */
.intro { margin-top: 32rpx; padding: 30rpx; }
.intro-title { font-size: 30rpx; font-weight: 600; color: var(--fg); }
.intro-text { font-size: 28rpx; line-height: 1.7; margin-top: 16rpx; }

/* 章节 */
.episodes { margin-top: 44rpx; }
.ep-head { margin-bottom: 22rpx; }
.ep-list { display: flex; flex-direction: column; gap: 20rpx; }
.ep-row { display: flex; align-items: center; padding: 24rpx 28rpx; }
.row-hover { opacity: 0.85; }
.ep-num { font-size: 28rpx; width: 44rpx; flex-shrink: 0; }
.ep-info { flex: 1; min-width: 0; }
.ep-title { font-size: 30rpx; font-weight: 600; color: var(--fg); }
.ep-dur { font-size: 24rpx; margin-top: 6rpx; }
.ep-play {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: rgba(245, 201, 123, 0.14);
  border: 1rpx solid rgba(245, 201, 123, 0.3);
  color: var(--lamp);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 底部播放条 */
.playbar {
  position: fixed;
  left: 40rpx; right: 40rpx; bottom: 40rpx;
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-radius: 999rpx;
  background: rgba(18, 29, 54, 0.92);
  border: 1rpx solid rgba(233, 237, 247, 0.12);
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.4);
}
.playbar-btn {
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: linear-gradient(135deg, var(--lamp), var(--lamp-deep));
  color: #1A2438;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.playbar-text { margin-left: 24rpx; }
.playbar-title { font-size: 28rpx; font-weight: 600; color: var(--fg); }
.playbar-sub { font-size: 24rpx; margin-top: 4rpx; }
.loading { text-align: center; padding: 200rpx 0; font-size: 26rpx; }
