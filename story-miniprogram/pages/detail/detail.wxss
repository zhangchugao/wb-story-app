.cover-stage {
  display: flex;
  justify-content: center;
  padding: 30rpx 0 20rpx;
  position: relative;
}
.big-cover {
  width: 420rpx;
  height: 420rpx;
  transform: rotateX(10deg) rotateY(-12deg) translateZ(40rpx);
  box-shadow: 0 40rpx 70rpx rgba(31, 42, 55, 0.22);
  border: 10rpx solid rgba(255, 255, 255, 0.7);
  animation: float 4s ease-in-out infinite;
}
.big-label { font-size: 72rpx; writing-mode: vertical-rl; letter-spacing: 8rpx; }
.cover-glow {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.35), transparent 55%);
}
.cover-shadow {
  position: absolute;
  bottom: 0;
  width: 360rpx;
  height: 40rpx;
  background: rgba(31, 42, 55, 0.14);
  border-radius: 50%;
  filter: blur(16rpx);
}
@keyframes float {
  0%, 100% { transform: rotateX(10deg) rotateY(-12deg) translateZ(40rpx) translateY(0); }
  50% { transform: rotateX(10deg) rotateY(-12deg) translateZ(40rpx) translateY(-16rpx); }
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}
.title-main { flex: 1; min-width: 0; }
.story-title { font-size: 46rpx; font-weight: 800; }
.story-byline { font-size: 24rpx; margin-top: 10rpx; }
.fav-btn {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #fff;
  color: #c4cbd2;
  font-size: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(31, 42, 55, 0.08);
}
.fav-on { color: #ef4444; }

.tags { display: flex; gap: 14rpx; margin-top: 24rpx; }
.pill.soft { background: #f0f5f2; color: #6b7280; }

.intro { margin-top: 36rpx; padding: 30rpx; border-radius: 26rpx; }
.intro-title { font-size: 28rpx; font-weight: 700; }
.intro-text { font-size: 26rpx; color: var(--ink-soft); line-height: 1.8; margin-top: 16rpx; }

.episodes { margin-top: 44rpx; }
.ep-head { margin-bottom: 24rpx; }
.ep-list { display: flex; flex-direction: column; gap: 16rpx; }
.ep-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 22rpx 26rpx;
  border-radius: 22rpx;
}
.ep-num {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: var(--mint-soft);
  color: var(--mint-deep);
  font-weight: 700;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ep-info { flex: 1; min-width: 0; }
.ep-title { font-size: 28rpx; font-weight: 600; }
.ep-dur { font-size: 22rpx; margin-top: 6rpx; }
.ep-play { color: #10b981; font-size: 30rpx; }

.playbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 32rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 22rpx 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #34d399, #10b981);
  box-shadow: 0 18rpx 40rpx rgba(16, 185, 129, 0.4);
  z-index: 20;
}
.playbar-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.playbar-text { flex: 1; }
.playbar-title { color: #fff; font-size: 30rpx; font-weight: 700; }
.playbar-sub { color: rgba(255, 255, 255, 0.8); font-size: 22rpx; margin-top: 4rpx; }

.loading { text-align: center; padding: 120rpx; font-size: 26rpx; }
