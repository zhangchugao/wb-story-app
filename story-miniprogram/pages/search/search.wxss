.search-bar {
  display: flex;
  align-items: center;
  height: 92rpx;
  background: #fff;
  border-radius: 999rpx;
  padding: 0 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(31, 42, 55, 0.06);
}
.search-icon { font-size: 40rpx; color: #10b981; margin-right: 16rpx; }
.search-input { flex: 1; font-size: 28rpx; }
.ph { color: #b0b7bf; }
.clear-btn { font-size: 40rpx; color: #9ca3af; padding: 0 8rpx; }

.hot-block { margin-top: 56rpx; }
.hot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin: 28rpx 0;
}
.hot-tag {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 26rpx;
  border-radius: 999rpx;
  background: #fff;
  font-size: 26rpx;
}
.hot-rank {
  color: #10b981;
  font-weight: 700;
}
.hint { font-size: 24rpx; margin-top: 20rpx; }

.result-block { margin-top: 44rpx; }
.result-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.result-count { font-size: 22rpx; }

.list { display: flex; flex-direction: column; gap: 20rpx; }
.row-card {
  display: flex;
  padding: 16rpx;
  gap: 20rpx;
  border-radius: 24rpx;
}
.row-cover {
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
  transform: rotateY(-6deg);
}
.row-label { font-size: 30rpx; }
.row-body { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; }
.row-title { font-size: 30rpx; font-weight: 700; }
.row-desc { font-size: 22rpx; margin-top: 8rpx; }
.row-meta { font-size: 22rpx; margin-top: 12rpx; }

.empty { text-align: center; font-size: 26rpx; padding: 80rpx 0; }
