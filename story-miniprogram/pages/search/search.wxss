/* 搜索页 · 今晚想听哪一种 */
.page { padding: 30rpx 40rpx 80rpx; }

.search-bar {
  display: flex;
  align-items: center;
  height: 92rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
}
.search-icon { font-size: 32rpx; }
.search-input { flex: 1; margin-left: 18rpx; font-size: 30rpx; color: var(--fg); }
.ph { color: var(--faint); }
.clear-btn { font-size: 36rpx; padding: 0 10rpx; }

/* 空状态引导 */
.empty-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 60rpx;
  text-align: center;
}
.hero-img {
  width: 460rpx;
  height: 340rpx;
  border-radius: 36rpx;
  border: 1rpx solid rgba(233, 237, 247, 0.10);
}
.empty-title { font-size: 36rpx; font-weight: 600; color: var(--fg); margin-top: 36rpx; }
.empty-sub { font-size: 26rpx; margin-top: 14rpx; }
.empty-btn {
  margin-top: 36rpx;
  padding: 20rpx 52rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #1A2438;
  background: linear-gradient(135deg, var(--lamp), var(--lamp-deep));
  box-shadow: 0 0 36rpx rgba(245, 201, 123, 0.3);
}

/* 热搜 */
.hot-block { margin-top: 60rpx; }
.hot-tags { display: flex; flex-wrap: wrap; gap: 18rpx; margin-top: 26rpx; }
.hot-tag {
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--fg);
}
.hint { font-size: 24rpx; margin-top: 30rpx; }

/* 结果 */
.result-head { font-size: 26rpx; margin: 36rpx 0 24rpx; }
.list { display: flex; flex-direction: column; gap: 20rpx; }
.row { display: flex; align-items: center; padding: 20rpx; }
.row-hover { opacity: 0.85; }
.row-thumb { width: 96rpx; height: 96rpx; border-radius: 24rpx; flex-shrink: 0; }
.row-body { flex: 1; margin-left: 24rpx; min-width: 0; }
.row-title { font-size: 30rpx; font-weight: 600; color: var(--fg); }
.row-meta { font-size: 24rpx; margin-top: 6rpx; }
.row-play {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: linear-gradient(135deg, var(--lamp), var(--lamp-deep));
  color: #1A2438;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 24rpx rgba(245, 201, 123, 0.3);
}

.no-result { text-align: center; padding: 80rpx 0 40rpx; }
.no-title { font-size: 32rpx; font-weight: 600; color: var(--fg); }
.no-sub { font-size: 26rpx; margin-top: 14rpx; }
