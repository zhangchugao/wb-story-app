.player-page {
  position: relative;
  min-height: 100vh;
  padding: 60rpx 40rpx 80rpx;
  overflow: hidden;
}
.bg-glow {
  position: absolute;
  top: -100rpx;
  left: -100rpx;
  right: -100rpx;
  height: 800rpx;
  opacity: 0.35;
  filter: blur(40rpx);
  z-index: 0;
}

.disc-stage {
  position: relative;
  display: flex;
  justify-content: center;
  padding: 80rpx 0 40rpx;
  z-index: 1;
  perspective: 1000rpx;
}
.disc {
  position: relative;
  width: 460rpx;
  height: 460rpx;
  border-radius: 50%;
  background: repeating-radial-gradient(circle, #2b2f33 0, #2b2f33 6rpx, #23272b 7rpx, #23272b 12rpx);
  box-shadow: 0 30rpx 60rpx rgba(0, 0, 0, 0.35), inset 0 0 0 4rpx rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotateX(16deg);
}
.disc-spin { animation: spin 8s linear infinite; }
@keyframes spin { from { transform: rotateX(16deg) rotate(0); } to { transform: rotateX(16deg) rotate(360deg); } }
.disc-label {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 30rpx;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  box-shadow: inset 0 0 30rpx rgba(0, 0, 0, 0.15);
}
.disc-hole {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #f7fbf9;
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}
.tonearm {
  position: absolute;
  top: 20rpx;
  right: 40rpx;
  width: 14rpx;
  height: 220rpx;
  background: linear-gradient(#cbd5d1, #9aa5a1);
  border-radius: 999rpx;
  transform-origin: top center;
  transform: rotate(28deg);
  transition: transform 0.5s ease;
  z-index: 3;
}
.tonearm::after {
  content: '';
  position: absolute;
  bottom: -16rpx;
  left: -10rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #b9c2be;
}
.tonearm-on { transform: rotate(8deg); }

.track-info { text-align: center; margin-top: 20rpx; z-index: 1; position: relative; }
.track-title { font-size: 44rpx; font-weight: 800; }
.track-artist { font-size: 24rpx; margin-top: 10rpx; }

.progress-wrap { margin-top: 56rpx; z-index: 1; position: relative; }
.progress { margin: 0; }
.progress-time {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  margin-top: 8rpx;
  padding: 0 8rpx;
}

.controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 50rpx;
  z-index: 1;
  position: relative;
}
.ctrl-side { width: 100rpx; text-align: center; }
.speed-badge, .sleep-badge {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  background: #fff;
  color: var(--mint-deep);
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(31, 42, 55, 0.08);
}
.sleep-badge { font-size: 22rpx; }
.ctrl-label { font-size: 20rpx; display: block; margin-top: 10rpx; }
.ctrl-main .skip-btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--mint-deep);
  font-size: 30rpx;
}
.play-main .play-circle {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #34d399, #10b981);
  color: #fff;
  font-size: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 36rpx rgba(16, 185, 129, 0.45);
}
.tip { text-align: center; font-size: 20rpx; margin-top: 60rpx; z-index: 1; position: relative; }
.loading { text-align: center; padding: 200rpx; font-size: 26rpx; }
