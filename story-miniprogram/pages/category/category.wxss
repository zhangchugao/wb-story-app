.cat-page {
  display: flex;
  height: 100vh;
  background: #f7fbf9;
}
.side {
  width: 180rpx;
  flex-shrink: 0;
  background: #f0f5f2;
  height: 100vh;
}
.side-title {
  font-size: 22rpx;
  padding: 32rpx 28rpx 16rpx;
  letter-spacing: 2rpx;
}
.side-item {
  position: relative;
  padding: 28rpx 28rpx;
  font-size: 27rpx;
  color: #6b7280;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.side-active {
  background: #fff;
  color: #059669;
  font-weight: 700;
  border-radius: 0 24rpx 24rpx 0;
}
.side-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #10b981;
}

.content {
  flex: 1;
  height: 100vh;
  padding: 28rpx 24rpx 60rpx;
}
.content-head { padding: 8rpx 8rpx 28rpx; }
.content-title { font-size: 40rpx; font-weight: 800; }
.content-sub { font-size: 22rpx; margin-top: 8rpx; }

.list { display: flex; flex-direction: column; gap: 20rpx; }
.row-card {
  display: flex;
  padding: 16rpx;
  gap: 20rpx;
  border-radius: 24rpx;
}
.row-cover {
  width: 150rpx;
  height: 150rpx;
  flex-shrink: 0;
  transform: rotateY(-6deg);
}
.row-label { font-size: 32rpx; }
.row-body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.row-title { font-size: 30rpx; font-weight: 700; }
.row-desc {
  font-size: 22rpx;
  margin-top: 8rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.row-meta {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.row-time { font-size: 22rpx; }

.empty, .loading { text-align: center; font-size: 24rpx; padding: 60rpx 0; }
