/* 分类页 · 按今晚的节奏挑 */
.page { padding: 30rpx 40rpx 80rpx; }

.page-title { font-size: 52rpx; font-weight: 700; color: var(--fg); margin-top: 10rpx; }
.page-sub { font-size: 26rpx; margin: 12rpx 0 40rpx; }

.cat-list { display: flex; flex-direction: column; gap: 20rpx; }
.cat-row {
  display: flex;
  align-items: center;
  padding: 20rpx;
}
.cat-on { border-color: rgba(245, 201, 123, 0.35); }
.row-hover { opacity: 0.85; }
.cat-thumb {
  width: 128rpx;
  height: 128rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
}
.cat-body { flex: 1; margin-left: 26rpx; min-width: 0; }
.cat-name { font-size: 32rpx; font-weight: 600; color: var(--fg); display: flex; align-items: center; gap: 16rpx; }
.cat-desc { font-size: 24rpx; margin-top: 8rpx; }
.cat-side { font-size: 24rpx; flex-shrink: 0; margin-left: 16rpx; }

.section { margin-top: 52rpx; }
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 22rpx;
}
.story-list { display: flex; flex-direction: column; gap: 20rpx; }
.story-row { display: flex; align-items: center; padding: 20rpx; }
.story-thumb { width: 96rpx; height: 96rpx; border-radius: 24rpx; flex-shrink: 0; }
.story-body { flex: 1; margin-left: 24rpx; min-width: 0; }
.story-title { font-size: 30rpx; font-weight: 600; color: var(--fg); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.story-meta { font-size: 24rpx; margin-top: 6rpx; }
.story-play {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: linear-gradient(135deg, var(--lamp), var(--lamp-deep));
  color: #1A2438;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 24rpx rgba(245, 201, 123, 0.3);
}
.empty, .loading { text-align: center; font-size: 26rpx; padding: 50rpx 0; }
