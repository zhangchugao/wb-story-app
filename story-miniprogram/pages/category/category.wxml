<view class="page">
  <view class="page-title">按今晚的节奏挑</view>
  <view class="page-sub muted">不按孩子学什么，按孩子现在的状态分</view>

  <!-- 分类行：插画缩略 + 推荐 -->
  <view class="cat-list">
    <view
      class="cat-row night-card {{activeId === item.id ? 'cat-on' : ''}}"
      wx:for="{{cats}}"
      wx:key="id"
      hover-class="row-hover"
      bindtap="switchCategory"
      data-id="{{item.id}}"
    >
      <image class="cat-thumb" src="{{item.img}}" mode="aspectFill" />
      <view class="cat-body">
        <view class="cat-name">
          {{item.name}}
          <text class="pill-lamp" wx:if="{{item.id === 1}}">今晚推荐</text>
        </view>
        <view class="cat-desc muted">{{item.desc}}</view>
      </view>
      <view class="cat-side muted">{{item.count}} 个故事 ›</view>
    </view>
  </view>

  <!-- 当前分类下的故事 -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">{{activeName}}</text>
      <text class="section-link muted">{{stories.length}} 个</text>
    </view>
    <view class="story-list">
      <view
        class="story-row night-card"
        wx:for="{{stories}}"
        wx:key="id"
        hover-class="row-hover"
        bindtap="goDetail"
        data-id="{{item.id}}"
      >
        <image class="story-thumb" src="{{item.cover}}" mode="aspectFill" />
        <view class="story-body">
          <view class="story-title">{{item.title}}</view>
          <view class="story-meta muted">{{item.narrator}} · {{item.durationText}}</view>
        </view>
        <view class="story-play" catchtap="goPlayer" data-id="{{item.id}}">▶</view>
      </view>
    </view>
    <view class="empty muted" wx:if="{{!loading && stories.length === 0}}">这一类的故事还在准备中</view>
    <view class="loading muted" wx:if="{{loading}}">加载中…</view>
  </view>
</view>
