/* 全局主题：「今夜的灯」深夜蓝夜空 + 暖黄唯一光源 */
page {
  --night1: #0F1B33;
  --night2: #1B2A4A;
  --night3: #24365C;
  --lamp: #F5C97B;
  --lamp-deep: #E8A94F;
  --moon: #F7EAD3;
  --fg: #E9EDF7;
  --muted: #93A0BF;
  --faint: #5A6787;
  --card: rgba(255, 255, 255, 0.06);
  --card-line: rgba(233, 237, 247, 0.10);
  background: #0F1B33;
  color: var(--fg);
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view, text { box-sizing: border-box; }

/* 通用页面：深夜蓝渐变（设计基准 375px，1px = 2rpx） */
.page {
  min-height: 100vh;
  padding: 30rpx 40rpx 80rpx;
  background: linear-gradient(180deg, #0F1B33 0%, #1B2A4A 60%, #233758 100%);
}

/* 夜色透明卡：统一容器（18px 圆角 = 36rpx） */
.night-card {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(233, 237, 247, 0.10);
  border-radius: 36rpx;
}

.muted { color: var(--muted); }
.faint { color: var(--faint); }
.lamp { color: var(--lamp); }

/* 区块标题 */
.section-title { font-size: 34rpx; font-weight: 600; color: var(--fg); }
.section-link { font-size: 24rpx; color: var(--muted); }

/* 暖黄小胶囊（仅用于关键词/选中态，全站唯一暖色之一） */
.pill-lamp {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--lamp);
  background: rgba(245, 201, 123, 0.14);
  border: 1rpx solid rgba(245, 201, 123, 0.25);
}
