# 服务端口
PORT=3000

# JWT 密钥（生产环境务必替换为随机长字符串）
JWT_SECRET=dev-secret-change-me-in-production

# JWT 有效期
JWT_EXPIRES_IN=30d

# 微信登录凭证（在微信公众平台获取；留空则使用开发模式 mock 登录）
WX_APPID=
WX_SECRET=

# MySQL 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=story_app
DB_POOL_SIZE=10

# 音频文件目录
AUDIO_DIR=./storage/audio

# 管理后台账号（生产环境务必修改）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
